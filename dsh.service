[Unit]
Description=DSH Web GUI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jinchan
WorkingDirectory=/home/jinchan/deepseek-harness
Environment=NODE_ENV=production
EnvironmentFile=-/home/jinchan/deepseek-harness/.env
ExecStart=/bin/bash -c 'source /home/jinchan/.nvm/nvm.sh && pnpm dsh web --no-open --trusted-host <your-frp-domain>'
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=dsh

[Install]
WantedBy=multi-user.target